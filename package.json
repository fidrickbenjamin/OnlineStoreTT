{
  "name": "onlinestore",
  "type": "module",
  "version": "1.0.0",
  "description": "Online Store App",
  "main": "app.js",
  "scripts": {
    "start": "node backend/app.js",
    "dev": "cross-env NODE_ENV=DEVELOPMENT nodemon backend/app.js",
    "prod": "cross-env NODE_ENV=PRODUCTION nodemon backend/app.js",
    "seeder": "node backend/seeder/seeder.js",
    "test:orders": "node --test --test-concurrency=1 tests/*.test.mjs",
    "orders:maintenance": "node backend/scripts/orderMaintenance.js"
  },
  "author": "Fidrick Benjamin",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "jwa": "^2.0.1",
    "mailtrap": "^4.10.0",
    "mongoose": "^8.24.4",
    "nodemailer": "^9.1.1",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14"
  }
