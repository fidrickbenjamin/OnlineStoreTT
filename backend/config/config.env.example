NODE_ENV=DEVELOPMENT
PORT=4000
FRONTEND_URL=http://localhost:3000
DB_LOCAL_URI=mongodb://127.0.0.1:27017/tactical-trends
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_EMAIL=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=store@example.com
SMTP_FROM_NAME=Tactical Trends
MAILTRAP_API_TOKEN=your-mailtrap-token
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your-webhook-id
SHOPDM_PAY_MERCHANT_HANDLE=your-merchant-handle
SHOPDM_PAY_WEBHOOK_SECRET=your-shopdm-webhook-secret
SHOPDM_PAY_SANDBOX=true
